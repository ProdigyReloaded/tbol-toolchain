PROGRAM PGDISP;
DATA
    dt = ACTION, RESULT;
PROC main =
    GOTO_DEPENDING_ON ACTION, DO_ADD, DO_SUB, DO_MUL;
    MOVE '0', RESULT;
    GOTO FINISH;
DO_ADD:
    ADD '10', RESULT;
    GOTO FINISH;
DO_SUB:
    SUBTRACT '10', RESULT;
    GOTO FINISH;
DO_MUL:
    MULTIPLY '2', RESULT;
FINISH:
    EXIT RESULT;
END_PROC
