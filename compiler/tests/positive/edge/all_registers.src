PROGRAM ALLREG;
DATA dt = A;
PROC main =
    MOVE '1', I1;
    MOVE '2', I2;
    MOVE '3', I3;
    MOVE '4', I4;
    MOVE '5', I5;
    MOVE '6', I6;
    MOVE '7', I7;
    MOVE '8', I8;
    MOVE '1', D1;
    MOVE '2', D2;
    MOVE '3', D3;
    MOVE '4', D4;
    MOVE '5', D5;
    MOVE '6', D6;
    MOVE '7', D7;
    MOVE '8', D8;
    MOVE '1', P0;
    MOVE '2', P1;
    MOVE '3', P2;
    MOVE '4', P3;
    MOVE '5', P4;
    MOVE '6', P5;
    MOVE '7', P6;
    MOVE '8', P7;
    MOVE I1, A;
END_PROC
