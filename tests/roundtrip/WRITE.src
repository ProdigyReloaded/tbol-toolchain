PROGRAM T_WRITE;

COPY XXCGTSYS;

DATA
  vars =
    RDA0,
    RDA1;

PROC main =
    { WRITE with 2 operands }
    WRITE RDA0, RDA1;

    { WRITE with literals }
    WRITE 'FILE', 'data';

    { WRITE with P register }
    MOVE 'TESTFILE', P0;
    MOVE 'content', P1;
    WRITE P0, P1;

    { WRITE with GEV }
    WRITE SYS_RETURN_CODE, RDA1;

    RETURN;
END_PROC
