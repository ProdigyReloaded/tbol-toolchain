PROGRAM T_MAKEFMT;

COPY XXCGTSYS;

DATA
  vars =
    RDA0,
    RDA1,
    RDA2,
    RDA3;

PROC main =
    { MAKE_FORMAT with dest and format specs }
    { Format: dest, source:fixlen:embedlen, source:fixlen:embedlen, ... }
    MAKE_FORMAT RDA0, RDA1:5:0, RDA2:10:2;

    { MAKE_FORMAT with literals in format specs }
    MAKE_FORMAT RDA0, 'PREFIX':3:0, RDA1:5:0;

    { MAKE_FORMAT with single spec }
    MAKE_FORMAT RDA0, RDA1:0:0;

    RETURN;
END_PROC
