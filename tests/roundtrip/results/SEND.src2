PROGRAM T_SEND;

COPY XXCGTSYS;

DATA
  vars =
    RDA0,
    RDA1,
    RDA2;                               { array, bounds unknown }

PROC main =
    SEND RDA0;
    SEND RDA0, PRIORITY;
    SEND RDA0, RDA1;
    SEND RDA0, RDA1, PRIORITY;
    MOVE 'message', P0;
    SEND P0;
    SEND 'test message';
    SEND RDA2;
    MOVE 3, I1;
    SEND RDA2(I1);
    SEND &1;
    SEND SYS_RETURN_CODE;
    RETURN;
END_PROC
