PROGRAM T_MULTIPLY;

COPY XXCGTSYS;

DATA
  vars =
    RDA0,
    RDA1,
    RDA2,                               { array, bounds unknown }
    RDA3,                               { unused }
    RDA4,                               { unused }
    RDA5,                               { unused }
    RDA6;

PROC main =
    MULTIPLY RDA0, RDA1;
    MULTIPLY 2, RDA0;
    MOVE 3, I1;
    MULTIPLY I1, RDA0;
    MULTIPLY RDA0, I1;
    MOVE 1.5, D1;
    MULTIPLY D1, RDA0;
    MULTIPLY RDA2, RDA0;
    MULTIPLY RDA0, RDA6;
    MOVE 3, I2;
    MULTIPLY RDA2(I2), RDA0;
    MULTIPLY &1, RDA0;
    MULTIPLY SYS_RETURN_CODE, RDA0;
    RETURN;
END_PROC
