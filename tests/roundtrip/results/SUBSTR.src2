PROGRAM T_SUBSTR;

COPY XXCGTSYS;

DATA
  vars =
    RDA0,
    RDA1,
    RDA2,
    RDA3;

PROC main =
    SUBSTR RDA0, RDA1, 1, 5;
    SUBSTR RDA0, RDA1, 1, 10;
    MOVE 3, I1;
    MOVE 5, I2;
    SUBSTR RDA0, RDA1, I1, I2;
    MOVE 'hello world', P0;
    SUBSTR P0, RDA1, 1, 5;
    SUBSTR RDA2, RDA1, 1, 5;
    SUBSTR RDA0, RDA3, 1, 5;
    MOVE 3, I3;
    SUBSTR RDA2(I3), RDA1, 1, 5;
    SUBSTR &1, RDA1, 1, 5;
    SUBSTR SYS_RETURN_CODE, RDA1, 1, 5;
    RETURN;
END_PROC
