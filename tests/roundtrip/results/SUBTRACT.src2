PROGRAM T_SUBTRACT;

COPY XXCGTSYS;

DATA
  vars =
    RDA0,
    RDA1,
    RDA2,                               { array, bounds unknown }
    RDA3,                               { unused }
    RDA4,                               { unused }
    RDA5,                               { unused }
    RDA6;

PROC main =
    SUBTRACT RDA0, RDA1;
    SUBTRACT 5, RDA0;
    MOVE 10, I1;
    SUBTRACT I1, RDA0;
    SUBTRACT RDA0, I1;
    MOVE 1.5, D1;
    SUBTRACT D1, RDA0;
    SUBTRACT RDA2, RDA0;
    SUBTRACT RDA0, RDA6;
    MOVE 3, I2;
    SUBTRACT RDA2(I2), RDA0;
    SUBTRACT &1, RDA0;
    SUBTRACT SYS_RETURN_CODE, RDA0;
    RETURN;
END_PROC
