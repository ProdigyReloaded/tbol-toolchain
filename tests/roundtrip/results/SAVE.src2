PROGRAM T_SAVE;

DATA
  vars =
    RDA0,
    RDA1,                               { unused }
    RDA2,                               { unused }
    RDA3,                               { unused }
    RDA4;

PROC main =
    SAVE 'BUFFER1', RDA0, RDA4;
    SAVE 'BUFFER2', RDA0;
    SAVE 'P_REGS', P1, P8;
    SAVE 'KEYS', &1, &10;
    RETURN;
END_PROC
