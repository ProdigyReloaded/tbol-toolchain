PROGRAM T_RECEIVE;

COPY XXCGTSYS;

DATA
  vars =
    RDA0,
    RDA1;

PROC main =
    { RECEIVE with 2 operands }
    RECEIVE RDA0, RDA1;

    { RECEIVE with literals }
    RECEIVE 'QUEUE', RDA1;

    { RECEIVE with P register }
    MOVE 'TESTQ', P0;
    RECEIVE P0, RDA1;

    { RECEIVE with GEV }
    RECEIVE SYS_RETURN_CODE, RDA1;

    RETURN;
END_PROC
