PROGRAM T_TEST;

COPY XXCGTSYS;

DATA
  vars =
    RDA0,
    RDA1;

PROC main =
    { TEST with 2 operands }
    TEST RDA0, RDA1;

    { TEST with literals }
    TEST 'PATTERN', RDA1;

    { TEST with P register }
    MOVE 'DATA', P0;
    TEST P0, RDA1;

    { TEST with GEV }
    TEST SYS_RETURN_CODE, RDA1;

    RETURN;
END_PROC
