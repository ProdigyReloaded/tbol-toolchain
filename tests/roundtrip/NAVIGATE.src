PROGRAM T_NAVIGATE;

COPY XXCGTSYS;

DATA
  vars =
    RDA0;

PROC main =
    { Basic NAVIGATE }
    NAVIGATE RDA0;

    { NAVIGATE with literal }
    NAVIGATE 'PAGENAME';

    { NAVIGATE with P register }
    MOVE 'TESTPAGE', P0;
    NAVIGATE P0;

    { NAVIGATE with GEV }
    NAVIGATE SYS_RETURN_CODE;

    RETURN;
END_PROC
